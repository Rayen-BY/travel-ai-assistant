# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Packaging and coverage outputs
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Generated data and model artifacts
data/raw/*
data/processed/*
data/external/*
models/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!models/.gitkeep

